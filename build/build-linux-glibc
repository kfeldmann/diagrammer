#!/usr/bin/env bash
#
# Build the x86_64-unknown-linux-gnu (dynamically linked glibc) release binary.
#
# Uses cargo-zigbuild with an explicit glibc floor of 2.26, so the binary runs
# on any x86_64 system with glibc >= 2.26.
#
# Runs inside the shared Debian trixie image (build/debian.Dockerfile). The
# container runs as the host UID:GID so everything written into the mounted
# project (target/) stays owned by you.

set -euo pipefail

here="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
root="$(cd -- "$here/.." && pwd)"

image="diagrammer-build-debian:latest"
uid="$(id -u)"
gid="$(id -g)"

docker build -f "$here/debian.Dockerfile" -t "$image" "$here"

# Cargo's home and $HOME live under the (gitignored) target/ directory, so the
# container user can write them and they persist across runs.
mkdir -p "$root/target/.cargo-home" "$root/target/.home"

docker run --rm \
  --user "$uid:$gid" \
  -v "$root:/work" \
  -w /work \
  -e HOME=/work/target/.home \
  -e CARGO_HOME=/work/target/.cargo-home \
  "$image" \
  cargo zigbuild --release -p diagrammer --target x86_64-unknown-linux-gnu.2.26

echo "built: $root/target/x86_64-unknown-linux-gnu/release/diagrammer"
