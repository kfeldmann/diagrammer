#!/usr/bin/env bash
#
# Cross-build the x86_64-pc-windows-gnu release binary (diagrammer.exe).
#
# Runs inside the shared Debian trixie image (build/debian.Dockerfile) using
# cargo-zigbuild, which drives Zig as the linker. Zig ships the MinGW-w64 CRT
# and import libraries, so no Windows SDK and no mingw-w64 toolchain is
# needed on the host. The container runs as the host UID:GID so everything
# written into the mounted project (target/) stays owned by you.
#
# Target choice: `-gnu`, not `-msvc`. Both produce a working .exe (this crate
# crosses no DLL boundary, so the ABI is invisible), but zig cannot drive the
# MSVC linker — `--target x86_64-pc-windows-msvc` fails with
# `/NOLOGO: unrecognized file extension`. The gnu target also statically links
# the MinGW runtime, so the .exe needs no libgcc_s_seh-1.dll /
# libwinpthread-1.dll alongside it; its only imports are OS components
# (KERNEL32, ntdll, WS2_32, USERENV, bcryptprimitives, api-ms-win-crt-*).
#
# The binary is unsigned. It runs as-is on Windows; see build/README.md for
# what that does and doesn't cost.

set -euo pipefail

here="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
root="$(cd -- "$here/.." && pwd)"

image="diagrammer-build-debian:latest"
uid="$(id -u)"
gid="$(id -g)"

docker build -f "$here/debian.Dockerfile" -t "$image" "$here"

# Cargo's home and $HOME live under the (gitignored) target/ directory, so the
# container user can write them and they persist across runs.
mkdir -p "$root/target/.cargo-home" "$root/target/.home"

docker run --rm \
  --user "$uid:$gid" \
  -v "$root:/work" \
  -w /work \
  -e HOME=/work/target/.home \
  -e CARGO_HOME=/work/target/.cargo-home \
  "$image" \
  cargo zigbuild --release -p diagrammer --target x86_64-pc-windows-gnu

echo "built: $root/target/x86_64-pc-windows-gnu/release/diagrammer.exe"
