diagram top-down

    user "User"
    group "Tencent"
        pubclb "Public CLB"
        vpn "VPN Endpoint"
        group left-right "Private subnets"
            prvclb "Private CLB"
            cvm1 "Middleware"
            cvm2 "Platform"
            cvm3 "Application"
            cvm4 "Algorithm"
            cvm5 "MultiDim DB"
            db "TDSQL DB" : cylinder
        end
    end

    user --> vpn -- "tech.finance.example.com\n443" --> prvclb -- "443" --> cvm2
    user -- thick "finance.example.com\n443" --> pubclb -- thick "8088" --> cvm1

    vpn -- "22, 8088, 8080,\n30001, 1234" --> cvm1
    vpn -- "22, 443" --> cvm2
    vpn -- "22, 443" --> cvm3
    vpn -- "22, 443" --> cvm4
    vpn -- "22, 443" --> cvm5
    vpn -- "3306" --> db
