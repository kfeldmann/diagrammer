diagram top-down

    group "Tencent Cloud Platform"

        vpn "VPN" fill="#99f"
        pub-clb "Public CLB" fill="#ccc"

        group left-right "Dev VPC" fill="#ddd"
            group "Dev/Digital\nSubnets" fill="#fff"
                prv-clb "Private CLB" fill="#ccc"
            end
            group "Dev/Shared Subnets" fill="#fff"
                tke "TKE Cluster" fill="#f99"
            end
        end
    end

    pub-clb --> tke
    vpn --> prv-clb --> tke
